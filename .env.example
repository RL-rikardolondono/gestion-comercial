# Datos de configuración del servidor. En Render se llenan en "Environment".
DATABASE_URL=postgres://usuario:clave@ep-xxxx-pooler.us-east-2.aws.neon.tech/gestion?sslmode=require   # Neon (gratis)
SECRET_KEY=una-clave-larga-y-secreta          # cifra los tokens de Meta. No la cambie después.
JWT_SECRET=otra-clave-larga-y-secreta         # firma las sesiones
CRON_SECRET=clave-del-despertador             # la usa cron-job.org para despertar el servidor
ADMIN_EMAIL=superadmin.agente@skynetgenesis.com   # Superadministrador de Agente-IA (si queda el correo viejo superadmin@, se ignora)
DUENO_CUENTAS=                                  # opcional: más correos del dueño cuyos enlaces de contraseña van a rikardolondono@gmail.com
NOTIFY_EMAIL=contacto@skynetgenesis.com       # avisos internos (pagos de Bold para revisar)
ADMIN_PASSWORD=una-contraseña-segura
ADMIN_NAME=Superadministrador
APP_ORIGIN=https://agente-ia.skynetgenesis.com
META_VERIFY_TOKEN=                            # texto para verificar el webhook de Meta
META_APP_SECRET=                              # "Clave secreta de la app" en developers.facebook.com
BREVO_API_KEY=                                # correo gratis: brevo.com › SMTP y API › Claves API
MAIL_FROM=SofIA · Agente-IA <sofia@skynetgenesis.com>
DEMO_PASSWORD=                                # opcional: cuenta demo@skynetgenesis.com para demostraciones
AI_ENABLED=false                              # sin inteligencia artificial (sin costo por mensaje)
